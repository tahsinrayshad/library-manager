# Copy to .env and edit as needed. Both the file and every variable in it are
# optional; with no .env present the application behaves exactly as before.

# Location of the SQLite database file.
#
# A relative path is resolved against the project root, NOT the directory the
# program is launched from. An absolute path is used as given, which lets a
# deployment keep data outside the source tree.
#
# Default: library.db  (i.e. <project root>/library.db)

# LIBRARY_DB_PATH=library.db
# LIBRARY_DB_PATH=data/library.db
# LIBRARY_DB_PATH=C:/Users/you/AppData/Local/library-manager/library.db
